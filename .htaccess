Options -MultiViews

# Cache longo para arquivos estaticos (CSS/JS usam ?v= para atualizar).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(?:webp|avif|jpe?g|png|svg|woff2?|css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

RewriteEngine On

# Normaliza barras duplicadas no endereco publico do atacado.
RewriteCond %{THE_REQUEST} \s/{2,}catalogo-atacado(?:[?\s]|/) [NC]
RewriteRule ^catalogo-atacado/?$ /catalogo-atacado [R=301,L,NE]

# Mantem o catalogo publico somente pelo endereco exclusivo.
RewriteRule ^catalogo-atacado/?$ catalogo.html [L,NC]

# Publica o catalogo de fardamento e normaliza barras duplicadas.
RewriteCond %{THE_REQUEST} \s/{2,}catalogo-fardamento(?:[?\s]|/) [NC]
RewriteRule ^catalogo-fardamento/?$ /catalogo-fardamento [R=301,L,NE]
RewriteRule ^catalogo-fardamento/?$ catalogo-fardamento.html [L,NC]

# Impede o acesso pelos enderecos antigos divulgados anteriormente.
RewriteCond %{THE_REQUEST} \s/+catalogo\.html(?:[?\s]) [NC]
RewriteRule ^catalogo\.html$ maintenance.html [L]
RewriteCond %{THE_REQUEST} \s/+catalogo-fardamento\.html(?:[?\s]) [NC]
RewriteRule ^catalogo-fardamento\.html$ maintenance.html [L,NC]
RewriteRule ^(?:catalogo|catalogo-fardamento|maintenance)\.html$ - [L,NC]
