Options -MultiViews

RewriteEngine On

# Normaliza barras duplicadas no endereco publico do atacado.
RewriteCond %{THE_REQUEST} \s/{2,}catalogo-atacado(?:[?\s]|/) [NC]
RewriteRule ^catalogo-atacado/?$ /catalogo-atacado [R=301,L,NE]

# Mantem o catalogo publico somente pelo endereco exclusivo.
RewriteRule ^catalogo-atacado/?$ catalogo.html [L,NC]

# Impede o acesso pelos enderecos antigos divulgados anteriormente.
RewriteCond %{THE_REQUEST} \s/+catalogo\.html(?:[?\s]) [NC]
RewriteRule ^catalogo\.html$ maintenance.html [L]
RewriteRule ^(?:catalogo|maintenance)\.html$ - [L,NC]

# Nao bloqueia os recursos usados pelo catalogo e pela tela de manutencao.
RewriteRule ^(?:assets|css|js|api)(?:/|$) - [L,NC]
RewriteRule \.(?:avif|css|gif|ico|jpe?g|js|json|map|mp4|png|svg|webm|webp|woff2?|ttf|eot)$ - [L,NC]

# A pagina inicial e as demais paginas do site ficam em manutencao.
RewriteRule ^$ maintenance.html [L]
RewriteRule ^.*\.html$ maintenance.html [L,NC]

# Rotas amigaveis que nao correspondem a arquivos tambem exibem a manutencao.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ maintenance.html [L]
